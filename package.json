{
  "name": "obelisk",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Explicit memory infrastructure for coding agents \u2014 a queryable SQLite evidence layer over local coding-agent history, plus human-approved durable memory.",
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:skill": "node packaging/build-skill.mjs",
    "publish:skill": "npm run build:skill && packaging/publish-skill.sh",
    "test:dsh": "npm run build --workspace @obelisk/dsh-obelisk-plugin && node --experimental-test-module-mocks --test tests/dsh-plugin.test.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs --binary target/release/obelisk"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
